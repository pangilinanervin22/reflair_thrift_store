# Placeholders only — real values live in .env (gitignored). Never paste secrets into this file.

# MongoDB Atlas connection string. It MUST include the database name ("/reflair"):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/reflair?appName=<app>
DATABASE_URL=

# next-auth v4 — generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# UploadThing v7 (product images) — the installed SDK reads UPLOADTHING_TOKEN only.
UPLOADTHING_TOKEN=

# Legacy UploadThing keys — not read by the installed SDK; kept so existing .env files still map.
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=
